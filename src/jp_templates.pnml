  //deco underlay
    template template_jp_underlay_deco (x, y) {
        [ x,      y,      64,      31,     -31,       0]   // ↗↙
        [ x,      y,      64,      31,     -31,       0]   // ↖↘
        [ x+70,   y,      64,      31,     -31,       0]   // ↔U
