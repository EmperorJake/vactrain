  // Fence
    template template_jp_fence (x, y) {
      [ x,      y,      32,      25,     -33,     -11]
      [ x+40,   y,      32,      25,       3,     -11]
      [ x+80,   y,       8,      39,      -3,     -24]
      [ x+100,  y,      64,      12,     -31,     -12]
