  // Tunnel
    template template_jp_tunnel_overlay_v2 (x, y) {
      [ x+70,      y,      66,      50,     -31,     -49]  // ↙
      [ x+70+278,  y,      66,      50,     -33,     -49]  // ↖
      [ x+70+138,  y,      66,      50,     -31,     -49]  // ↗
      [ x+70+418,  y,      66,      50,     -31,     -48]  // ↘
    }
    template template_jp_tunnel_underlay_v2 (x, y) {
        [ x,      y,      66,      50,     -31,     -19]  // ↙
