  // Bridge Surface
    template template_jp_bridge_surface (x, y) {
        [ x,      y,      64,      31,     -31,       0]   // ↗↙
        [ x+70,   y,      64,      31,     -31,       0]   // ↖↘
        [ x+140,  y,      64,      39,     -31,      -8]   // ↗ slope up
        [ x+210,  y,      64,      23,     -31,       0]   // ↘ slope up 
        [ x+280,  y,      64,      23,     -31,       0]   // ↙ slope up
        [ x+350,  y,      64,      39,     -31,      -8]   // ↖ slope up
    }
    template template_jp_bridge_surface_v2 () {
      [0,   360,    64,      31,     -31,       0]   // ↗↙
      [70,  360,    64,      31,     -31,       0]   // ↖↘
      [140, 360,    64,      39,     -31,      -8]   // ↗ slope up
      [210, 360,    64,      23,     -31,       0]   // ↘ slope up  
      [280, 360,    64,      23,     -31,       0]   // ↙ slope up 
      [350, 360,    64,      39,     -31,      -8]   // ↖ slope up
    }
    template template_jp_bridge_surface_deco (x, y) {
        [ x,      y,      64,      31,     -31,       0]   // ↗↙
        [ x,      y,      64,      31,     -31,       0]   // ↖↘
        [ x+350,  y,      64,      39,     -31,      -8]   // ↗ slope up
        [ x+420,  y,      64,      23,     -31,       0]   // ↘ slope up 
        [ x+490,  y,      64,      23,     -31,       0]   // ↙ slope up
