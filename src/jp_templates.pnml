//* Tracks overlay
  spriteset(spriteset_jp_overlay, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/jp/1067_overlay.png") {
    template_jp_overlay (0, 0)
  }
  spriteset(spriteset_jp_overlay_snow_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/jp/1067_overlay_snow.png") {
    template_jp_overlay (0, 0)
  }
  switch(FEAT_RAILTYPES, SELF, switch_jp_overlay_snow, terrain_type) {
    TILETYPE_SNOW: spriteset_jp_overlay_snow_1;
    spriteset_jp_overlay;
  }
//

//* Maglev
  //Underlay+Combined
    spriteset(spriteset_jp_maglev_underlay_snow, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/jp/track_maglev_snow.png") {template_jp_underlay_v2 (0, 0)}
    spriteset(spriteset_jp_maglev_underlay_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/jp/track_maglev.png") {template_jp_underlay_v2 (0, 0)}
    switch(FEAT_RAILTYPES, SELF, switch_jp_maglev_underlay, terrain_type) {
      TILETYPE_SNOW: spriteset_jp_maglev_underlay_snow;
      spriteset_jp_maglev_underlay_def;
    }
    spriteset(spriteset_jp_maglev_combined_snow, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/jp/track_maglev_snow.png") {template_jp_combined (0, 0)}
    spriteset(spriteset_jp_maglev_combined_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/jp/track_maglev.png") {template_jp_combined (0, 0)}
    switch(FEAT_RAILTYPES, SELF, switch_jp_maglev_combined, terrain_type) {
      TILETYPE_SNOW: spriteset_jp_maglev_combined_snow;
      spriteset_jp_maglev_combined_def;
    }
  // Bridge
    spriteset(spriteset_jp_maglev_bridge, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/jp/track_maglev.png") {
       template_jp_bridge_surface_v2()
    }

//Fences
    spriteset (gfx_fence_empty, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/fences_symmetric.png") {template_jp_fence(0,0)}
    spriteset (gfx_fence_concrete, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/fences_symmetric.png") {template_jp_fence(0,50)}
    spriteset (gfx_fence_concrete_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/fences_symmetric.png") {template_jp_fence(0,100)}

//Tunnels
    spriteset(tunnel_standard_maglev_underlay_conc, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/tunnel_maglev.png") {
        template_jp_tunnel_underlay_v2 (0, 0)
        }
        spriteset(tunnel_standard_maglev_underlay_snow, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/tunnel_maglev.png") {
          template_jp_tunnel_underlay_v2 (0, 120)
        }
        switch(FEAT_RAILTYPES, SELF, switch_tunnel_standard_maglev_underlay, terrain_type) {
          TILETYPE_SNOW: tunnel_standard_maglev_underlay_snow;
          tunnel_standard_maglev_underlay_conc;
        }

        spriteset(tunnel_standard_maglev_overlay_conc, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/tunnel_maglev.png") {
          template_jp_tunnel_overlay_v2 (0, 0)
        }
        spriteset(tunnel_standard_maglev_overlay_snow, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/tracks/tunnel_maglev.png") {
          template_jp_tunnel_overlay_v2 (0, 120)
        }
        switch(FEAT_RAILTYPES, SELF, switch_tunnel_standard_maglev_overlay, terrain_type) {
          TILETYPE_SNOW: tunnel_standard_maglev_overlay_snow;
          tunnel_standard_maglev_overlay_conc;
        }
