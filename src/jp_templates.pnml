//Templates n stuff, nicked from JP+ Tracks
  // Overlay
    template template_jp_overlay (x, y) {
        [ x,      y,      64,      31,     -31,       0]   // ↗↙
        [ x+70,   y,      64,      31,     -31,       0]   // ↖↘
        [ x+140,  y,      64,      31,     -31,       0]   // ↔U
        [ x+210,  y,      64,      31,     -31,       0]   // ↔D
        [ x+280,  y,      64,      31,     -31,       0]   // ↕R
        [ x+350,  y,      64,      31,     -31,       0]   // ↕L
        [ x+420,  y,      64,      39,     -31,      -8]   // ↗ slope up
        [ x+490,  y,      64,      23,     -31,       0]   // ↘ slope up 
        [ x+560,  y,      64,      23,     -31,       0]   // ↙ slope up
        [ x+630,  y,      64,      39,     -31,      -8]   // ↖ slope up
    }
  // Underlay v2
    template template_jp_underlay_v2 (x, y) {
      [ x+70,   y,      64,      31,     -31,       0]   // ↗↙
      [ x+140,  y,      64,      31,     -31,       0]   // ↖↘
      [ x+280,  y,      64,      31,     -31,       0]   // ↔U
      [ x+0,    y+40,   64,      31,     -31,       0]   // ↔D
      [ x+0,    y+160,  64,      31,     -31,       0]   // ↕R
      [ x+0,    y+80,   64,      31,     -31,       0]   // ↕L
      [ x+0,    y+320,  64,      39,     -31,      -8]   // ↗ slope up
      [ x+70,   y+320,  64,      23,     -31,       0]   // ↘ slope up  
      [ x+140,  y+320,  64,      23,     -31,       0]   // ↙ slope up 
      [ x+210,  y+320,  64,      39,     -31,      -8]   // ↖ slope up
      [ x,y,1,1,0,0]
      [ x,y,1,1,0,0]
      [ x,y,1,1,0,0]
      [ x,y,1,1,0,0]
      [ x,y,1,1,0,0]
      [ x,y,1,1,0,0]
    }
