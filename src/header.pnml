/*
This is a NewGRF which adds a Vacuum Tube Railtype, and some trains to go with it, to OpenTTD.

Code by Emperor Jake, using parts from code by Terkhen, planetmaker, Transportman, FooBar, WORD559 and possibly others

(c) 2026 Emperor Jake. Licensed under GPLv2+
*/

grf {
 grfid: "\4A\4B\59\01";
 name: string(STR_GRF_NAME);
 desc: string(STR_GRF_DESCRIPTION);
 version: 150;
 min_compatible_version: 140;



    param {
        param_starting_year {
            type: int;
            name: string(STR_PARAM_STARTING_YEAR);
            desc: string(STR_PARAM_STARTING_YEAR_DESC);
            min_value: 0;
            max_value: 4999900;
            def_value: 2025;
        }
    }

    param {
        param_vactrain_speed {
            type: int;
            name: string(STR_PARAM_SPEED);
            desc: string(STR_PARAM_SPEED_DESC);
            min_value: 1000;
            max_value: 65535;
            def_value: 2400;
        }
    }

 //cost parameters
 //courtesy of Terkhen
    param {
        param_running_cost_mult {
            type: int;
