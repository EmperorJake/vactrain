}

//train look nice thing
traininfo_y_offset = 2;
train_width_32_px = 1;

/*
 * deactivate outdated vactrain grfs
 *
 * 444A5901 original vactrain set
 * 444A5902 vacuum vehicule [sic] wagon
 * 444A5903 vactrain set fork
 * 42533033 Brianum vacuum monorail tube
 * 42533034 Brianum vacuum monorail trains
 */


deactivate("\44\4A\59\01",  "\44\4A\59\02", "\44\4A\59\03", "\42\53\30\33", "\42\53\30\34");
