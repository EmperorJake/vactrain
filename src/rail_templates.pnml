//spritesets for rails

//Overlay Maglev
spriteset(spriteset_fsmaglev_overlay,"gfx/tracks/overlay_mag.png") {
	template_overlay()
}

//Underlay Maglev
spriteset(spriteset_fsmaglev_underlay,"gfx/tracks/underlay_mag.png") {
	template_underlay()
}

//Tunnel Maglev
