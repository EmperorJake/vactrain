//Cargo wagon


switch (FEAT_TRAINS, SELF, switch_wagon_cargo_capacity, param_vehicle_capacity) {
    0: return 40;
    1: return 50;
    2: return 60;
}

//variants

random_switch (FEAT_TRAINS, SELF, switch_wagon_cargo_0_random_base) {
    1: spriteset_cargo_box_wagon_1;
    1: spriteset_cargo_box_wagon_2;
    1: spriteset_cargo_box_wagon_4;
    1: spriteset_cargo_box_wagon_5;
    2: spriteset_cargo_box_wagon_6;
}

random_switch (FEAT_TRAINS, SELF, switch_wagon_cargo_0_random_logo) {
    independent: switch_wagon_cargo_0_random_base;
    4: spriteset_cargo_box_overlay_blank;
    1: spriteset_cargo_box_overlay_1;
    1: spriteset_cargo_box_overlay_2;
    1: spriteset_cargo_box_overlay_4;
    1: spriteset_cargo_box_overlay_5;
}

switch(FEAT_TRAINS, SELF, switch_wagon_cargo_0_stack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
       getbits(extra_callback_info1, 8, 8)
]) {
    0:  switch_wagon_cargo_0_random_base;
    1:  switch_wagon_cargo_0_random_logo;
}


item (FEAT_TRAINS, vactrain_wagon_cargo_0, 200) {
    property {
        sprite_id: SPRITE_ID_NEW_TRAIN;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        track_type: VACT;
        name: string(STR_NAME_CARGO_WAGON);
        climates_available: ALL_CLIMATES;
        introduction_date: date(param_starting_year+5,1,1);
        power: 0;
        cargo_capacity: 50;
        refittable_cargo_classes: ALL_NORMAL_CARGO_CLASSES;
        non_refittable_cargo_classes: bitmask(CC_PASSENGERS);
        weight: 41;
        loading_speed: 30;
        cost_factor: 45;
        length: 8;
        badges: ["power/vactrain", "role/freight"];
        }
  graphics {
    //	purchase: spriteset_wagon_cargo_purchase;
        default: switch_wagon_cargo_0_stack;
        cargo_capacity: switch_wagon_cargo_capacity;
        loading_speed: switch_loading_speed_mu;
    }
}


