//Pillbug

spriteset(spriteset_pillbug_pax_head, "gfx/trains/pillbug.png") {
	template_2cc_std(1, 1)
}

spriteset(spriteset_pillbug_mail_head, "gfx/trains/pillbug.png") {
	template_2cc_std(1, 32)
}

spriteset(spriteset_pillbug_pax, "gfx/trains/pillbug.png") {
	template_2cc_std(1, 64)
}

spriteset(spriteset_pillbug_mail, "gfx/trains/pillbug.png") {
	template_2cc_std(1, 96)
}

spriteset(spriteset_pillbug_purchase, "gfx/trains/pillbug.png") {
    template_purchase_dualheaded(1, 128)
}

spriteset(spriteset_pillbug_mail_purchase, "gfx/trains/pillbug.png") {
	template_purchase_dualheaded(1, 160)
}

//PILLBUG

switch (FEAT_TRAINS, SELF, switch_pillbug_capacity, param_vehicle_capacity) {
    0: return 88;
    1: return 110;
    2: return 132;
}

switch (FEAT_TRAINS, SELF, switch_pillbug_purchase_capacity, param_vehicle_capacity) {
    0: return 88-22;
    1: return 110;
    2: return 132+22;
}

//railtype switches
switch (FEAT_TRAINS, SELF, switch_pillbug_speed, current_railtype) {
    VACT: return switch_vactrain_speed_gen3;
    MGLV: return 320;
    CB_FAILED;
}

switch (FEAT_TRAINS, SELF, switch_pillbug_cost, current_railtype) {
    VACT: return 125;
    MGLV: return 55;
    CB_FAILED;
}


//mail car gfx
switch (FEAT_TRAINS, SELF, switch_pillbug_cargo, cargo_classes) {
    bitmask(CC_PASSENGERS): spriteset_pillbug_pax;
    spriteset_pillbug_mail;
}
//mail head gfx
switch (FEAT_TRAINS, SELF, switch_pillbug_cargo_head, cargo_classes) {
    bitmask(CC_PASSENGERS): spriteset_pillbug_pax_head;
    spriteset_pillbug_mail_head;
}


//main item
item (FEAT_TRAINS, pillbug, 166) {
    property {
        sprite_id: SPRITE_ID_NEW_TRAIN;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        track_type: VACT;
        name: string(STR_NAME_PILLBUG);
        climates_available: ALL_CLIMATES;
        introduction_date: date(param_starting_year+60,1,1);
        speed: 2000 km/h;
        air_drag_coefficient: 0;
        power: 28000 hp;
        dual_headed: 1;
        engine_class: ENGINE_CLASS_MAGLEV;
        cargo_capacity: 110;
        loading_speed: 80;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        weight: 63;
        reliability_decay: 12;
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 52;
        cost_factor: 190;
        running_cost_factor: 125;
        running_cost_base: RUNNING_COST_STEAM;
        badges: ["power/vactrain", "role/passenger"];
    }
    graphics {
        additional_text:	string(STR_CONCAT_1,
                                   string(STR_DESC_AIRSPEED, 320),
        );
        speed: switch_pillbug_speed;
        running_cost_factor: switch_pillbug_cost;
        can_attach_wagon: switch_can_attach_vehicle;
        purchase: spriteset_pillbug_purchase;
        default: switch_pillbug_cargo_head;
        loading_speed: switch_loading_speed_mu;
        cargo_capacity: switch_pillbug_capacity;
        purchase_cargo_capacity: switch_pillbug_purchase_capacity;
    }

    livery_override(vactrain_wagon_pax) { // graphics for alternative look of passenger wagon when used with this engine
        loading_speed: 80;
        power: 14000;
        weight: 62;
        running_cost_factor: 80;
        cargo_capacity: switch_pillbug_capacity;
        length: 8;
        default: switch_pillbug_cargo;
    }
    livery_override(vactrain_wagon_exp) { // graphics for alternative look of passenger wagon when used with this engine
        loading_speed: 80;
        power: 14000;
        weight: 58;
        running_cost_factor: 20;
        cargo_capacity: switch_pillbug_capacity;
        length: 8;
        default: switch_pillbug_cargo;
    }

}

