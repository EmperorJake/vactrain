STR_DESC_AIRSPEED                         :{BLACK}Geschwindigkeit außerhalb der Röhre: {GOLD}{UNSIGNED_WORD} km/h{}
STR_DESC_WAGONCAP                         :{BLACK}Zusätzliche Kapazität für Passagier-/Expresswagen

# wagons
STR_NAME_PAX_WAGON                        :Passagierwagen
STR_NAME_EXP_WAGON                        :Expressfrachtwagen
STR_NAME_CARGO_WAGON                      :Universalgüterwagen
STR_NAME_BULK_WAGON                       :Schüttgutwagen

# general
STR_NEW_ENGINE                            :Vakuumzuglokomotive
STR_AUTOREPLACE                           :Vakuumzugfahrzeuge
STR_BUILD_CAPTION                         :Neue Vakuumzugfahrzeuge
STR_TOOLBAR_CAPTION                       :Vakuumröhrenbau
STR_VAC_RAIL                              :Vakuumröhrenstrecke bauen
STR_VAC_NAME                              :Vakuumröhrenstrecke

# general parameters
STR_PARAM_CAPACITY                        :Kapazität der Vakuumzüge ändern
STR_PARAM_CAPACITY_DESC                   :Ermöglicht die Anpassung der Kapazität von Vakuumzugfahrzeugen.{}{}Konservativ: {WHITE}-20%{BLACK}{}Großzügig: {WHITE}+20%{BLACK}
STR_PARAM_CAPACITY_LOW                    :Konservativ
STR_PARAM_CAPACITY_MED                    :Normal
STR_PARAM_CAPACITY_HIGH                   :Großzügig

STR_PARAM_LOADSPEED                       :Ladegeschwindigkeit der Vakuumzüge ändern
STR_PARAM_LOADSPEED_DESC                  :Ermöglicht die Anpassung der Ladegeschwindigkeit von Vakuumzugfahrzeugen
STR_PARAM_LOADSPEED_LOW                   :Konservativ
STR_PARAM_LOADSPEED_MED                   :Normal
STR_PARAM_LOADSPEED_HIGH                  :Großzügig

STR_PARAM_STARTING_YEAR                   :Einführungsjahr ändern
STR_PARAM_STARTING_YEAR_DESC              :Passt das Einführungsjahr für Passagier- und Expressvakuumzüge an. Gütervakuumzüge werden ungefähr 5 Jahre später eingeführt.
STR_PARAM_MAGLEVGFX                       :Maglev-Streckengrafiken ersetzen
STR_PARAM_MAGLEVGFX_DESC                  :Legt fest, ob die Standard-Maglevstrecke durch Grafiken ersetzt wird, die zur Vakuumröhrenstrecke passen. Deaktivieren, um Grafiken des Basisspiels oder Maglevstrecken eines anderen NewGRF zu verwenden.
STR_PARAM_ALLOWMAGLEV                     :Maglevzüge auf Vakuumröhrenstrecken erlauben
STR_PARAM_ALLOWMAGLEV_DESC                :Legt fest, ob normale Maglevzüge auf Vakuumröhrenstrecken fahren dürfen. Dies umfasst Standard-Maglevzüge sowie kompatible NewGRF-Maglevzüge.
STR_PARAM_ALLOWVACTRAIN                   :Vakuumzüge auf Maglevstrecken erlauben
STR_PARAM_ALLOWVACTRAIN_DESC              :Legt fest, ob Vakuumzüge auf normalen Maglevstrecken fahren dürfen.
STR_PARAM_SPEED                           :Höchstgeschwindigkeit der Vakuumzüge ändern
STR_PARAM_SPEED_DESC                      :Ermöglicht die Anpassung der Höchstgeschwindigkeit der schnellsten Vakuumzuggeneration. Frühere Generationen werden proportional angepasst.

# cost parameters
STR_PARAM_RUNNING_COST                    :Betriebskosten anpassen
STR_PARAM_RUNNING_COST_DESC               :Ermöglicht die Anpassung der Betriebskosten der Vakuumzüge
STR_PARAM_PURCHASE_COST                   :Anschaffungskosten anpassen
STR_PARAM_PURCHASE_COST_DESC              :Ermöglicht die Anpassung der Anschaffungskosten der Vakuumzüge
STR_PARAM_RAIL_COST                       :Streckenbaukosten anpassen
STR_PARAM_RAIL_COST_DESC                  :Ermöglicht die Anpassung der Bau- und Abrisskosten von Vakuumröhrenstrecken.
STR_PARAM_MAINTENANCE_COST                :Streckenwartungskosten anpassen
STR_PARAM_MAINTENANCE_COST_DESC           :Ermöglicht die Anpassung der Wartungskosten von Vakuumröhrenstrecken. Die Infrastrukturwartung muss aktiviert sein, damit diese Einstellung wirksam wird.

STR_PARAM_COST_AUTOMATICALLY              :automatisch (Standard)
STR_PARAM_COST_BY256                      :1 / 256
STR_PARAM_COST_BY128                      :1 / 128
STR_PARAM_COST_BY64                       :1 / 64
STR_PARAM_COST_BY32                       :1 / 32
STR_PARAM_COST_BY16                       :1 / 16
STR_PARAM_COST_BY8                        :1 / 8
STR_PARAM_COST_BY4                        :1 / 4
STR_PARAM_COST_BY2                        :1 / 2
STR_PARAM_COST_NORMAL                     :normal
STR_PARAM_COST_TIMES2                     :2x
STR_PARAM_COST_TIMES4                     :4x
STR_PARAM_COST_TIMES8                     :8x
STR_PARAM_COST_TIMES16                    :16x
STR_PARAM_COST_TIMES32                    :32x
STR_PARAM_COST_TIMES64                    :64x
STR_PARAM_COST_TIMES128                   :128x
STR_PARAM_COST_TIMES256                   :256x
STR_PARAM_COST_TIMES512                   :512x
