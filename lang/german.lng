##grflangid 0x02

lang: 7F

STR_GRF_NAME :Vactrain Set {VERSION}
STR_GRF_DESCRIPTION :Vakuumzüge fahren in Vakuumröhren und erreichen dadurch unglaubliche Geschwindigkeiten, allerdings zu einem exorbitanten Preis. Unverzichtbar für Spiele in ferner Zukunft. Grafiken von Emperor Jake, Voyager One, DJNekkid, Purno, Froix, Erato und Zephyris; Code von Emperor Jake und anderen, veröffentlicht unter GPLv2 oder höher.

# badges
STR_BADGE_POWER                           :Antrieb
STR_BADGE_POWER_VACTRAIN                  :Vakuumzug
STR_BADGE_ROLE                            :Rolle
STR_BADGE_ROLE_PAX                        :Passagier
STR_BADGE_ROLE_EXP                        :Expressfracht
STR_BADGE_ROLE_CARGO                      :Fracht
STR_BADGE_ROLE_UNIV                       :Universal

# locomotives
STR_NAME_SWIFT                            :Swift
STR_NAME_HYDRA                            :Hydra
STR_NAME_SCARAB                           :Scarab
STR_NAME_COBRA                            :Cobra

# multiple units
STR_NAME_CROSSLEY                         :Crossley
STR_NAME_SWALLOW                          :Swallow
STR_NAME_TAPEWORM                         :Tapeworm
STR_NAME_BISON                            :Bison
STR_NAME_CHEETAH                          :Cheetah
STR_NAME_PILLBUG                          :Pillbug
STR_NAME_SPAMCAN                          :Spamcan
STR_NAME_ROCKETMAX                        :Rocketmax

# cargo locomotives
STR_NAME_CARGO_1                          :Coelacanth
STR_NAME_CARGO_2                          :Juggernaut
STR_NAME_CARGO_3                          :Capybara
STR_NAME_CARGO_4                          :Cyber Dragon

# additional text
