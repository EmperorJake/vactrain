##grflangid 0x05

STR_GRF_NAME :Vakutrajna Aro {VERSION}
STR_GRF_DESCRIPTION :Vakutrajnoj veturas en vakuaj tuboj por atingi enormajn rapidojn, sed je altega prezo. Nepra por ludado en la fora estonteco. Grafikaĵoj de Emperor Jake, Voyager One, DJNekkid, Purno, Froix, Erato kaj Zephyris; programado de Emperor Jake kaj aliaj, publikigita laŭ GPLv2 aŭ posta.

# badges
STR_BADGE_POWER                           :Movforto
STR_BADGE_POWER_VACTRAIN                  :Vakutrajno
STR_BADGE_ROLE                            :Rolo
STR_BADGE_ROLE_PAX                        :Pasaĝera
STR_BADGE_ROLE_EXP                        :Ekspresa ŝarĝo
STR_BADGE_ROLE_CARGO                      :Ŝarĝo
STR_BADGE_ROLE_UNIV                       :Universala

# locomotives
STR_NAME_SWIFT                            :Swift
STR_NAME_HYDRA                            :Hydra
STR_NAME_SCARAB                           :Scarab
STR_NAME_COBRA                            :Cobra

# multiple units
STR_NAME_CROSSLEY                         :Crossley
STR_NAME_SWALLOW                          :Swallow
STR_NAME_TAPEWORM                         :Tapeworm
STR_NAME_BISON                            :Bison
STR_NAME_CHEETAH                          :Cheetah
STR_NAME_PILLBUG                          :Pillbug
STR_NAME_SPAMCAN                          :Spamcan
STR_NAME_ROCKETMAX                        :Rocketmax

# cargo locomotives
STR_NAME_CARGO_1                          :Coelacanth
STR_NAME_CARGO_2                          :Juggernaut
STR_NAME_CARGO_3                          :Capybara
STR_NAME_CARGO_4                          :Cyber Dragon

# additional text
STR_CONCAT_1                              :{STRING}
STR_CONCAT_2                              :{STRING}{STRING}
STR_CONCAT_3                              :{STRING}{STRING}{STRING}
STR_CONCAT_4                              :{STRING}{STRING}{STRING}{STRING}
STR_DESC_AIRSPEED                         :{BLACK}Atmosfera rapido: {GOLD}{UNSIGNED_WORD} km/h{}
STR_DESC_WAGONCAP                         :{BLACK}Plia kapacito por pasaĝeraj/ekspresaj vagonoj

# wagons
STR_NAME_PAX_WAGON                        :Pasaĝervagono
STR_NAME_EXP_WAGON                        :Ekspresŝarĝa vagono
STR_NAME_CARGO_WAGON                      :Universala ŝarĝvagono
STR_NAME_BULK_WAGON                       :Grocaĵvagono

# general
STR_NEW_ENGINE                            :Vakutrajna lokomotivo
STR_AUTOREPLACE                           :Vakutrajnaj veturiloj
STR_BUILD_CAPTION                         :Novaj vakutrajnaj veturiloj
STR_TOOLBAR_CAPTION                       :Konstruado de vakutuba trako
STR_VAC_RAIL                              :Konstruado de vakutuba trako
STR_VAC_NAME                              :Vakutubaj trakoj

# general parameters
STR_PARAM_CAPACITY                        :Ŝanĝi la kapaciton de vakutrajnoj
STR_PARAM_CAPACITY_DESC                   :Permesas ŝanĝi la kapaciton de vakutrajnaj veturiloj.{}{}Konservativa: {WHITE}-20%{BLACK}{}Malavara: {WHITE}+20%{BLACK}
STR_PARAM_CAPACITY_LOW                    :Konservativa
STR_PARAM_CAPACITY_MED                    :Normala
STR_PARAM_CAPACITY_HIGH                   :Malavara

STR_PARAM_LOADSPEED                       :Ŝanĝi la ŝarĝrapidon de vakutrajnoj
STR_PARAM_LOADSPEED_DESC                  :Permesas ŝanĝi la ŝarĝrapidon de vakutrajnaj veturiloj
STR_PARAM_LOADSPEED_LOW                   :Konservativa
STR_PARAM_LOADSPEED_MED                   :Normala
STR_PARAM_LOADSPEED_HIGH                  :Malavara

STR_PARAM_STARTING_YEAR                   :Ŝanĝi la enkondukan jaron
STR_PARAM_STARTING_YEAR_DESC              :Agordu la enkondukan jaron por pasaĝeraj kaj ekspresaj vakutrajnoj. Ŝarĝaj vakutrajnoj estos enkondukitaj proksimume 5 jarojn poste.
STR_PARAM_MAGLEVGFX                       :Anstataŭigi la grafikaĵojn de maglevaj trakoj
STR_PARAM_MAGLEVGFX_DESC                  :Elektu ĉu anstataŭigi la bazajn maglevajn trakojn per grafikaĵoj kongruaj kun la vakutubaj trakoj. Malŝaltu por uzi la grafikaĵojn de la baza aro aŭ maglevajn trakojn de alia NewGRF.
STR_PARAM_ALLOWMAGLEV                     :Permesi maglevajn trajnojn sur vakutubaj trakoj
STR_PARAM_ALLOWMAGLEV_DESC                :Elektu ĉu permesi al ordinaraj maglevaj trajnoj veturi sur vakutubaj trakoj. Tio inkluzivas kaj la bazajn maglevajn trajnojn kaj kongruajn NewGRF-maglevajn trajnojn.
STR_PARAM_ALLOWVACTRAIN                   :Permesi vakutrajnojn sur maglevaj trakoj
STR_PARAM_ALLOWVACTRAIN_DESC              :Elektu ĉu permesi al vakutrajnoj veturi sur ordinaraj maglevaj trakoj.
STR_PARAM_SPEED                           :Ŝanĝi la maksimuman rapidon de vakutrajnoj
STR_PARAM_SPEED_DESC                      :Permesas ŝanĝi la maksimuman rapidon de la plej rapida generacio de vakutrajnoj. Antaŭaj generacioj estos proporcie adaptitaj.

# cost parameters
STR_PARAM_RUNNING_COST                    :Agordi rulajn kostojn
STR_PARAM_RUNNING_COST_DESC               :Permesas agordi la rulajn kostojn de vakutrajnoj
STR_PARAM_PURCHASE_COST                   :Agordi aĉetkostojn
STR_PARAM_PURCHASE_COST_DESC              :Permesas agordi la aĉetkostojn de vakutrajnoj
STR_PARAM_RAIL_COST                       :Agordi trakkonstruajn kostojn
STR_PARAM_RAIL_COST_DESC                  :Permesas agordi la konstruajn kaj forigajn kostojn de vakutubaj trakoj.
STR_PARAM_MAINTENANCE_COST                :Agordi trakprizorgajn kostojn
STR_PARAM_MAINTENANCE_COST_DESC           :Permesas agordi la prizorgajn kostojn de vakutubaj trakoj. Infrastruktura prizorgado devas esti ŝaltita por ke ĉi tio efiku.

STR_PARAM_COST_AUTOMATICALLY              :aŭtomata (defaŭlta)
STR_PARAM_COST_BY256                      :1 / 256
STR_PARAM_COST_BY128                      :1 / 128
STR_PARAM_COST_BY64                       :1 / 64
STR_PARAM_COST_BY32                       :1 / 32
STR_PARAM_COST_BY16                       :1 / 16
STR_PARAM_COST_BY8                        :1 / 8
STR_PARAM_COST_BY4                        :1 / 4
STR_PARAM_COST_BY2                        :1 / 2
STR_PARAM_COST_NORMAL                     :normala
STR_PARAM_COST_TIMES2                     :2x
STR_PARAM_COST_TIMES4                     :4x
STR_PARAM_COST_TIMES8                     :8x
STR_PARAM_COST_TIMES16                    :16x
STR_PARAM_COST_TIMES32                    :32x
STR_PARAM_COST_TIMES64                    :64x
STR_PARAM_COST_TIMES128                   :128x
STR_PARAM_COST_TIMES256                   :256x
STR_PARAM_COST_TIMES512                   :512x
