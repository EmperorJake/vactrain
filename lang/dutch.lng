STR_DESC_AIRSPEED                         :{BLACK}Atmosferische snelheid: {GOLD}{UNSIGNED_WORD} km/h{}
STR_DESC_WAGONCAP                         :{BLACK}Extra capaciteit voor passagiers-/expresswagons

# wagons
STR_NAME_PAX_WAGON                        :Passagierswagon
STR_NAME_EXP_WAGON                        :Expressgoederenwagon
STR_NAME_CARGO_WAGON                      :Universele goederenwagon
STR_NAME_BULK_WAGON                       :Bulkgoederenwagon

# general
STR_NEW_ENGINE                            :Vacuümtreinlocomotief
STR_AUTOREPLACE                           :Vacuümtreinvoertuigen
STR_BUILD_CAPTION                         :Nieuwe vacuümtreinvoertuigen
STR_TOOLBAR_CAPTION                       :Vacuümbaanbouw
STR_VAC_RAIL                              :Vacuümbaan bouwen
STR_VAC_NAME                              :Vacuümbaan

# general parameters
STR_PARAM_CAPACITY                        :Capaciteit van vacuümtreinen aanpassen
STR_PARAM_CAPACITY_DESC                   :Hiermee kan de capaciteit van vacuümtreinvoertuigen worden aangepast.{}{}Conservatief: {WHITE}-20%{BLACK}{}Royaal: {WHITE}+20%{BLACK}
STR_PARAM_CAPACITY_LOW                    :Conservatief
STR_PARAM_CAPACITY_MED                    :Normaal
STR_PARAM_CAPACITY_HIGH                   :Royaal

STR_PARAM_LOADSPEED                       :Laadsnelheid van vacuümtreinen aanpassen
STR_PARAM_LOADSPEED_DESC                  :Hiermee kan de laadsnelheid van vacuümtreinvoertuigen worden aangepast
STR_PARAM_LOADSPEED_LOW                   :Conservatief
STR_PARAM_LOADSPEED_MED                   :Normaal
STR_PARAM_LOADSPEED_HIGH                  :Royaal

STR_PARAM_STARTING_YEAR                   :Introductiejaar aanpassen
STR_PARAM_STARTING_YEAR_DESC              :Pas het introductiejaar voor passagiers- en expressvacuümtreinen aan. Goederenvacuümtreinen verschijnen ongeveer 5 jaar later.
STR_PARAM_MAGLEVGFX                       :Maglevbaangraphics vervangen
STR_PARAM_MAGLEVGFX_DESC                  :Kies of de standaard maglevbaan moet worden vervangen door graphics die bij de vacuümbaan passen. Schakel dit uit om graphics van de basisset of maglevbanen van een andere NewGRF te gebruiken.
STR_PARAM_ALLOWMAGLEV                     :Maglevtreinen op vacuümbanen toestaan
STR_PARAM_ALLOWMAGLEV_DESC                :Kies of standaard maglevtreinen op vacuümbanen mogen rijden. Dit omvat zowel standaardmaglevtreinen als compatibele NewGRF-maglevtreinen.
STR_PARAM_ALLOWVACTRAIN                   :Vacuümtreinen op maglevbanen toestaan
STR_PARAM_ALLOWVACTRAIN_DESC              :Kies of vacuümtreinen op standaard maglevbanen mogen rijden.
STR_PARAM_SPEED                           :Maximumsnelheid van vacuümtreinen aanpassen
STR_PARAM_SPEED_DESC                      :Hiermee kan de topsnelheid van de snelste generatie vacuümtreinen worden aangepast. Eerdere generaties worden evenredig aangepast.

# cost parameters
STR_PARAM_RUNNING_COST                    :Bedrijfskosten aanpassen
STR_PARAM_RUNNING_COST_DESC               :Hiermee kunnen de bedrijfskosten van vacuümtreinen worden aangepast
STR_PARAM_PURCHASE_COST                   :Aankoopkosten aanpassen
STR_PARAM_PURCHASE_COST_DESC              :Hiermee kunnen de aankoopkosten van vacuümtreinen worden aangepast
STR_PARAM_RAIL_COST                       :Bouwkosten van de baan aanpassen
STR_PARAM_RAIL_COST_DESC                  :Hiermee kunnen de bouw- en verwijderingskosten van vacuümbanen worden aangepast.
STR_PARAM_MAINTENANCE_COST                :Onderhoudskosten van de baan aanpassen
STR_PARAM_MAINTENANCE_COST_DESC           :Hiermee kunnen de onderhoudskosten van vacuümbanen worden aangepast. Infrastructuuronderhoud moet zijn ingeschakeld om dit effect te laten hebben.

STR_PARAM_COST_AUTOMATICALLY              :automatisch (standaard)
STR_PARAM_COST_BY256                      :1 / 256
STR_PARAM_COST_BY128                      :1 / 128
STR_PARAM_COST_BY64                       :1 / 64
STR_PARAM_COST_BY32                       :1 / 32
STR_PARAM_COST_BY16                       :1 / 16
STR_PARAM_COST_BY8                        :1 / 8
STR_PARAM_COST_BY4                        :1 / 4
STR_PARAM_COST_BY2                        :1 / 2
STR_PARAM_COST_NORMAL                     :normaal
STR_PARAM_COST_TIMES2                     :2x
STR_PARAM_COST_TIMES4                     :4x
STR_PARAM_COST_TIMES8                     :8x
