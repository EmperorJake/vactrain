##grflangid 0x1F

STR_GRF_NAME :Vacuümtreinset {VERSION}
STR_GRF_DESCRIPTION :Vacuümtreinen rijden door vacuümbuizen om duizelingwekkende snelheden te bereiken, maar tegen een exorbitante prijs. Essentieel voor gameplay in de verre toekomst. Graphics door Emperor Jake, Voyager One, DJNekkid, Purno, Froix, Erato en Zephyris; code door Emperor Jake en anderen, uitgebracht onder GPLv2 en hoger.

# badges
STR_BADGE_POWER                           :Aandrijving
STR_BADGE_POWER_VACTRAIN                  :Vacuümtrein
STR_BADGE_ROLE                            :Rol
STR_BADGE_ROLE_PAX                        :Passagiers
STR_BADGE_ROLE_EXP                        :Expressgoederen
STR_BADGE_ROLE_CARGO                      :Goederen
STR_BADGE_ROLE_UNIV                       :Universeel

# locomotives
STR_NAME_SWIFT                            :Swift
STR_NAME_HYDRA                            :Hydra
